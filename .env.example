# Meu Bot — exemplo sem segredos. Copie para .env local ou configure no painel.
# Termux: omita BOT_AUTH_DIR para manter a sessão local em sessao_bot_v107.
# KataBump: defina obrigatoriamente BOT_AUTH_DIR=/home/container/suzuke_auth
BOT_AUTH_DIR=
BOT_OWNER_NUMBER=
BOT_OWNER_NUMBER_NO9=
BOT_OWNER_LID=
BOT_OWNER_LID_PURO=
BOT_MASTER_PASSWORD=
# qr ou pairing; na hospedagem, pairing evita depender de stdin interativo
BOT_CONNECTION_METHOD=pairing
BOT_PAIRING_NUMBER=
# Token do GitHub: prefira o comando !token ou variável protegida do painel.
# GITHUB_TOKEN=
# GH_TOKEN=
